---
// Layout de las guías escritas en Markdown (src/pages/guias/*.md)
import Base from './Base.astro';
import Migas from '../components/Migas.astro';
import Icono from '../components/Icono.astro';
import { waLink } from '../config/site';
import { abs, breadcrumbJsonLd } from '../lib/seo';

const { frontmatter } = Astro.props;
const url = Astro.url.pathname;
const migas = [
  { name: 'Inicio', href: '/' },
  { name: 'Guías', href: '/guias/' },
  { name: frontmatter.titulo, href: url },
];
const articulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.titulo,
  description: frontmatter.descripcion,
  dateModified: frontmatter.actualizado,
  author: { '@id': abs('/#inmobiliaria') },
  publisher: { '@id': abs('/#inmobiliaria') },
  mainEntityOfPage: abs(url),
};
---
<Base title={frontmatter.titulo} description={frontmatter.descripcion} noindex={Boolean(frontmatter.borrador)} jsonLd={[articulo, breadcrumbJsonLd(migas)]}>
  <article class="contenedor prosa" style="padding-block:28px 96px">
    <Migas items={migas} />
    <h1>{frontmatter.titulo}</h1>
    <p class="nota" style="margin-bottom:28px">Actualizado: {frontmatter.actualizadoTexto}</p>
    <slot />
    <div class="aviso" style="margin-top:40px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
      <p style="margin:0;font-size:16px">¿Querés que te ayudemos con tu caso puntual?</p>
      <a class="btn btn--wa" href={waLink(`Hola! Leí la guía "${frontmatter.titulo}" y tengo una consulta.`)} style="text-decoration:none" rel="noopener"><Icono nombre="wa" />Escribinos por WhatsApp</a>
    </div>
  </article>
</Base>
