---
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icono from '../components/Icono.astro';
import { SITE, waLink } from '../config/site';
import { abs, orgJsonLd } from '../lib/seo';

interface Props {
  title: string; // sin el nombre de la inmobiliaria: se agrega solo
  description: string;
  image?: string;
  jsonLd?: object | object[];
  sobreHero?: boolean;
  activo?: string;
  noindex?: boolean;
  tituloCompleto?: boolean; // true = usar title tal cual
}
const { title, description, image, jsonLd = [], sobreHero = false, activo = '', noindex = false, tituloCompleto = false } = Astro.props;

const fullTitle = tituloCompleto ? title : `${title} | ${SITE.name}`;
const canonical = abs(Astro.url.pathname);
const ogImage = image ?? abs('/og.jpg');
const schemas = [orgJsonLd(), ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#141517" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header sobreHero={sobreHero} activo={activo} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <a class="wa-flotante" href={waLink()} aria-label="Escribinos por WhatsApp" rel="noopener"><Icono nombre="wa" tam={28} /></a>

    <script>
      // Links a otros sitios (WhatsApp, Maps, Instagram, Google): en otra pestaña, así no se pierde la página
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
        if (a.host === location.host) return;
        a.target = '_blank';
        a.rel = 'noopener';
      });
    </script>
    <script>
      // Formularios que se envían por WhatsApp: arman el mensaje con los campos completados.
      document.querySelectorAll<HTMLFormElement>('form[data-wa]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const lineas = [form.dataset.wa || 'Hola!'];
          new FormData(form).forEach((v, k) => {
            const val = String(v).trim();
            if (val) lineas.push(`${k}: ${val}`);
          });
          const url = `https://wa.me/${form.dataset.numero}?text=${encodeURIComponent(lineas.join('\n'))}`;
          window.open(url, '_blank', 'noopener');
        });
      });
    </script>
  </body>
</html>
