---
import Base from '../../../../layouts/Base.astro';
import Listado from '../../../../components/Listado.astro';
import { getPropiedades, filtrar, ordenarRecientes, OPERACIONES, tipoPorSlug, type Operacion } from '../../../../lib/tokko';
import { rutasTipo, relacionadosDe, h1Listado } from '../../../../lib/rutas';
import { zonaPorSlug } from '../../../../data/zonas';
import { breadcrumbJsonLd } from '../../../../lib/seo';

export async function getStaticPaths() {
  const props = await getPropiedades();
  return rutasTipo(props).map((r) => ({ params: { op: r.op, zona: r.zona, tipo: r.tipo } }));
}

const op = Astro.params.op as Operacion;
const zona = zonaPorSlug(Astro.params.zona!)!;
const tipo = tipoPorSlug(Astro.params.tipo!)!;
const todas = await getPropiedades();
const items = ordenarRecientes(filtrar(todas, { operacion: op, zona: zona.slug, tipoSlug: tipo.slug }));
const h1 = h1Listado(op, zona.slug, tipo.slug);
const migas = [
  { name: 'Inicio', href: '/' },
  { name: OPERACIONES[op].label, href: `/${op}/` },
  { name: zona.nombre, href: `/${op}/${zona.slug}/` },
  { name: tipo.plural, href: `/${op}/${zona.slug}/${tipo.slug}/` },
];
const intro = `${tipo.plural} ${OPERACIONES[op].enLabel} en ${zona.nombre}, con fotos reales y precio a la vista. ${zona.resumen}`;
---
<Base
  title={h1}
  description={`${h1}: ${items.length} ${items.length === 1 ? 'disponible' : 'disponibles'} hoy. ${zona.resumen}`}
  activo={op}
  jsonLd={breadcrumbJsonLd(migas)}
>
  <Listado
    h1={h1}
    intro={intro}
    items={items}
    op={op}
    migas={migas}
    bloques={op === 'venta' ? zona.bloques : []}
    tituloBloques={op === 'venta' && zona.bloques.length ? `Comprar en ${zona.nombre}: lo que conviene saber` : ''}
    relacionados={relacionadosDe(todas, op, zona.slug, tipo.slug)}
    filtrosFijos={{ op: true, zona: true, tipo: true }}
  />
</Base>
