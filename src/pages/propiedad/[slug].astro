---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import TarjetaPropiedad from '../../components/TarjetaPropiedad.astro';
import Icono from '../../components/Icono.astro';
import { SITE, waLink, waNumero } from '../../config/site';
import { getPropiedades, precioDe, similares, tituloSeo, OPERACIONES, type Propiedad } from '../../lib/tokko';
import { urlListado, rutasTipo } from '../../lib/rutas';
import { breadcrumbJsonLd, propiedadJsonLd, abs } from '../../lib/seo';
import { formatoNumero, parrafos, resumen } from '../../lib/text';
import { iconoCaracteristica } from '../../lib/iconos';
import { fotoWeb } from '../../lib/fotos';
import { zonaPorSlug } from '../../data/zonas';

export async function getStaticPaths() {
  const props = await getPropiedades();
  return props.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Propiedad };
const todas = await getPropiedades();
const op = p.operaciones[0];
const linea = op === 'venta' ? 'general' : 'alquiler';
const precio = precioDe(p, op);
const otrosPrecios = p.precios.filter((x) => x !== precio);
const zona = p.zona ? zonaPorSlug(p.zona) : undefined;
const existeTipo = zona && rutasTipo(todas).some((r) => r.op === op && r.zona === zona.slug && r.tipo === p.tipoSlug);

const migas = [
  { name: 'Inicio', href: '/' },
  { name: OPERACIONES[op].label, href: `/${op}/` },
  ...(zona ? [{ name: zona.nombre, href: urlListado(op, zona.slug) }] : []),
  ...(zona && existeTipo ? [{ name: p.tipo, href: urlListado(op, zona.slug, p.tipoSlug) }] : []),
  { name: p.titulo, href: `/propiedad/${p.slug}/` },
];

const datos = [
  p.dormitorios && { k: 'Dormitorios', v: p.dormitorios },
  p.banos && { k: 'Baños', v: p.toilettes ? `${p.banos} + toilette` : p.banos },
  !p.banos && p.toilettes && { k: 'Toilettes', v: p.toilettes },
  p.supCubierta && { k: 'Sup. cubierta', v: `${formatoNumero(p.supCubierta)} m²` },
  p.supTerreno && { k: 'Terreno', v: `${formatoNumero(p.supTerreno)} m²` },
  !p.supCubierta && !p.supTerreno && p.supTotal && { k: 'Superficie', v: `${formatoNumero(p.supTotal)} m²` },
  p.cocheras && { k: 'Cocheras', v: p.cocheras },
  p.antiguedad !== null && { k: 'Antigüedad', v: p.antiguedad === 0 ? 'A estrenar' : `${p.antiguedad} años` },
  p.aptoCredito && { k: 'Documentación', v: 'Apto crédito' },
].filter(Boolean) as { k: string; v: string | number }[];

const mensaje = `Hola! Me interesa la propiedad "${p.titulo}" (código ${p.codigo}). ¿Cuándo se puede visitar?`;
const url = abs(`/propiedad/${p.slug}/`);
const desc = resumen(`${precio.valor ? precio.texto + '. ' : ''}${p.titulo}. ${p.descripcion}`, 158);
// Mapa: zona aproximada, nunca la ubicación exacta. La coordenada se redondea (~100 m) y el
// centro del círculo se corre entre ~90 y ~145 m en una dirección fija por propiedad: la casa
// queda dentro del círculo pero no en el centro.
const RADIO_ZONA = 350; // metros
const zonaMapa = p.lat && p.lng && p.ubicacionExacta
  ? { lat: p.lat.toFixed(5), lng: p.lng.toFixed(5) }
  : p.lat && p.lng
  ? (() => {
      const h = [...p.id].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
      const ang = ((h % 360) * Math.PI) / 180;
      const dist = 0.0008 + (h % 500) / 1e6; // grados de latitud
      const lat = Math.round(p.lat * 1000) / 1000 + Math.sin(ang) * dist;
      const lng = Math.round(p.lng * 1000) / 1000 + (Math.cos(ang) * dist) / Math.cos((p.lat * Math.PI) / 180);
      return { lat: lat.toFixed(5), lng: lng.toFixed(5) };
    })()
  : null;
const parecidas = similares(todas, p);
const fotos = p.fotos;
// La primera ocupa media galería; las otras cuatro, un cuarto
const galeria = await Promise.all(fotos.slice(0, 5).map((f, i) => fotoWeb(f.url, i === 0 ? [800, 1200] : [480, 800])));
---
<Base
  title={tituloSeo(p, todas)}
  description={desc}
  image={fotos[0]?.url}
  activo={op}
  jsonLd={[propiedadJsonLd(p, url), breadcrumbJsonLd(migas)]}
>
  <div class="contenedor" style="padding-block:24px 80px">
    <Migas items={migas} />

    {fotos.length > 0 ? (
      <div class="galeria" data-galeria>
        {fotos.slice(0, 5).map((f, i) => (
          <button type="button" data-foto={i} aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}>
            <img src={galeria[i].src} srcset={galeria[i].srcset || undefined} sizes={i === 0 ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 100vw, 25vw'} alt={f.alt} width="800" height="600" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
            {i === 4 && fotos.length > 5 && <span class="galeria__mas">Ver las {fotos.length} fotos</span>}
          </button>
        ))}
      </div>
    ) : (
      <div class="galeria galeria--vacia"><div>Fotos próximamente</div></div>
    )}

    <div class="ficha">
      <article class="ficha__main">
        <div class="ficha__sellos">
          {p.operaciones.map((o) => <span class:list={['op', { 'op--alquiler': o !== 'venta' }]}>{OPERACIONES[o].label}</span>)}
          {p.aptoCredito && <span>Apto crédito</span>}
        </div>
        <h1>{p.titulo}</h1>
        {p.tituloTokko && <p class="ficha__lugar">{p.tituloTokko}</p>}
        <p class="ficha__precio">
          {precio.texto}
          {otrosPrecios.map((o) => <small>{OPERACIONES[o.operacion].label}: {o.texto}</small>)}
          {p.expensas && <small>Expensas: $ {formatoNumero(p.expensas)}</small>}
        </p>

        {datos.length > 0 && (
          <dl class="datos">
            {datos.map((d) => <div><dt>{d.k}</dt><dd>{d.v}</dd></div>)}
          </dl>
        )}

        {p.descripcion && (
          <section class="ficha__bloque ficha__desc">
            <h2>Descripción</h2>
            <Fragment set:html={parrafos(p.descripcion)} />
          </section>
        )}

        {p.etiquetas.length > 0 && (
          <section class="ficha__bloque">
            <h2>Características</h2>
            <ul class="lista-extras">{p.etiquetas.map((t) => <li><Fragment set:html={iconoCaracteristica(t)} />{t}</li>)}</ul>
          </section>
        )}

        {p.videos[0] && (
          <section class="ficha__bloque">
            <h2>Recorrido en video</h2>
            <div class="video-wrap">
              <iframe src={p.videos[0]} title={`Video de ${p.titulo}`} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            </div>
          </section>
        )}

        <section class="ficha__bloque">
          <h2>Ubicación</h2>
          {zonaMapa && <div class="mapa" data-mapa data-lat={zonaMapa.lat} data-lng={zonaMapa.lng} data-radio={RADIO_ZONA} data-exacta={p.ubicacionExacta ? '1' : undefined} role="region" aria-label={p.ubicacionExacta ? `Mapa con la ubicación de la propiedad en ${p.ubicacion}` : `Mapa con la zona aproximada de la propiedad en ${p.ubicacion}`}></div>}
          <p class="nota" style="margin-top:10px">{p.ubicacionExacta ? `Ubicación de la propiedad en ${p.ubicacion}.` : `Zona aproximada en ${p.ubicacion}. La dirección exacta te la pasamos al coordinar la visita.`}</p>
        </section>

        <p class="nota" style="margin-top:28px">Código de referencia: {p.codigo}</p>
      </article>

      <aside class="contacto-lateral" aria-label="Consultar por esta propiedad">
        <h2>¿Te interesa? Coordinemos la visita</h2>
        <a class="btn btn--wa btn--cuadrado" style="min-height:54px" href={waLink(mensaje, linea)} rel="noopener"><Icono nombre="wa" tam={20} />Consultar por WhatsApp</a>
        <p class="nota" style="text-align:center">o dejanos tus datos y te escribimos</p>
        <form style="display:flex;flex-direction:column;gap:14px" data-wa={mensaje} data-numero={waNumero(linea)}>
          <label class="campo">Nombre<input type="text" name="Nombre" autocomplete="name" required /></label>
          <label class="campo">Teléfono<input type="tel" name="Teléfono" autocomplete="tel" /></label>
          <label class="campo">Mensaje<textarea name="Mensaje" rows="3"></textarea></label>
          <button class="btn btn--tinta btn--cuadrado" type="submit">Enviar consulta</button>
        </form>
        {p.aptoCredito && <p class="nota nota--borde">La evaluación del crédito y el cálculo de la cuota los hace el banco. Nosotros te pasamos la documentación de la propiedad.</p>}
      </aside>
    </div>

    {parecidas.length > 0 && (
      <section style="margin-top:72px">
        <h2 class="titulo-seccion" style="margin-bottom:22px">También te pueden interesar</h2>
        <div class="grilla grilla--chica">{parecidas.map((x) => <TarjetaPropiedad p={x} op={op} />)}</div>
      </section>
    )}
  </div>

  {fotos.length > 0 && (
    <div class="visor" data-visor data-abierto="false" role="dialog" aria-modal="true" aria-label="Fotos de la propiedad">
      <img alt="" data-visor-img />
      <button class="visor__cerrar" type="button" aria-label="Cerrar" data-visor-cerrar>×</button>
      <button class="visor__ant" type="button" aria-label="Foto anterior" data-visor-ant>‹</button>
      <button class="visor__sig" type="button" aria-label="Foto siguiente" data-visor-sig>›</button>
      <p class="visor__cont" data-visor-cont></p>
    </div>
    <script type="application/json" data-fotos set:html={JSON.stringify(fotos.map((f) => ({ url: f.url, alt: f.alt })))} />
  )}
</Base>

<script>
  // Mapa con la zona aproximada (Leaflet + OpenStreetMap). Se carga recién cuando el mapa se acerca a la pantalla.
  const contMapa = document.querySelector<HTMLElement>('[data-mapa]');
  if (contMapa) {
    const iniciar = async () => {
      const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
      const { lat, lng, radio, exacta } = contMapa.dataset;
      const mapa = L.map(contMapa, { scrollWheelZoom: false });
      mapa.attributionControl.setPrefix('<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>');
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(mapa);
      const centro = L.latLng(Number(lat), Number(lng));
      if (exacta) {
        // Pin propio (SVG) para no depender de las imágenes de marcador de Leaflet
        const pin = L.divIcon({
          className: 'mapa__pin',
          html: '<svg width="32" height="42" viewBox="0 0 32 42" aria-hidden="true"><path d="M16 1C7.7 1 1 7.6 1 15.8 1 27 16 41 16 41s15-14 15-25.2C31 7.6 24.3 1 16 1z" fill="#E64E1B" stroke="#fff" stroke-width="2"/><circle cx="16" cy="16" r="5.5" fill="#fff"/></svg>',
          iconSize: [32, 42],
          iconAnchor: [16, 41],
        });
        mapa.setView(centro, 16);
        L.marker(centro, { icon: pin, keyboard: false, alt: 'Ubicación de la propiedad' }).addTo(mapa);
        return;
      }
      mapa.fitBounds(centro.toBounds(Number(radio) * 2), { padding: [24, 24] });
      L.circle(centro, { radius: Number(radio), color: '#E64E1B', weight: 2, fillColor: '#E64E1B', fillOpacity: 0.18 }).addTo(mapa);
    };
    new IntersectionObserver((e, obs) => {
      if (e[0].isIntersecting) { obs.disconnect(); iniciar(); }
    }, { rootMargin: '300px' }).observe(contMapa);
  }

  const visor = document.querySelector<HTMLElement>('[data-visor]');
  const datos = document.querySelector('[data-fotos]');
  if (visor && datos) {
    const fotos: { url: string; alt: string }[] = JSON.parse(datos.textContent || '[]');
    const img = visor.querySelector<HTMLImageElement>('[data-visor-img]')!;
    const cont = visor.querySelector('[data-visor-cont]')!;
    let i = 0;
    let origen: HTMLElement | null = null;
    const mostrar = (n: number) => {
      i = (n + fotos.length) % fotos.length;
      img.src = fotos[i].url;
      img.alt = fotos[i].alt;
      cont.textContent = `${i + 1} / ${fotos.length}`;
    };
    const abrir = (n: number, el: HTMLElement) => { origen = el; mostrar(n); visor.dataset.abierto = 'true'; visor.querySelector<HTMLButtonElement>('[data-visor-cerrar]')?.focus(); };
    const cerrar = () => { visor.dataset.abierto = 'false'; origen?.focus(); };
    document.querySelectorAll<HTMLButtonElement>('[data-foto]').forEach((b) => b.addEventListener('click', () => abrir(Number(b.dataset.foto), b)));
    visor.querySelector('[data-visor-cerrar]')?.addEventListener('click', cerrar);
    visor.querySelector('[data-visor-ant]')?.addEventListener('click', () => mostrar(i - 1));
    visor.querySelector('[data-visor-sig]')?.addEventListener('click', () => mostrar(i + 1));
    visor.addEventListener('click', (e) => { if (e.target === visor) cerrar(); });
    document.addEventListener('keydown', (e) => {
      if (visor.dataset.abierto !== 'true') return;
      if (e.key === 'Escape') cerrar();
      if (e.key === 'ArrowLeft') mostrar(i - 1);
      if (e.key === 'ArrowRight') mostrar(i + 1);
    });
  }
</script>
