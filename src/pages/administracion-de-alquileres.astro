---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icono from '../components/Icono.astro';
import { waLink } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';

const migas = [{ name: 'Inicio', href: '/' }, { name: 'Administración de alquileres', href: '/administracion-de-alquileres/' }];
const servicios = [
  { t: 'Cobranza mensual', d: 'Cobramos el alquiler en efectivo, transferencia o Mercado Pago y te avisamos al instante.' },
  { t: 'Servicios bajo control', d: 'Seguimos luz, agua y tasa de cada propiedad para que no se acumulen deudas a tu nombre.' },
  { t: 'Aumentos por índice', d: 'Aplicamos los ajustes que fija el contrato (IPC, ICL u otro) en tiempo y forma.' },
  { t: 'Liquidación con comprobante', d: 'Cada mes recibís el detalle de lo cobrado, los descuentos y la transferencia.' },
  { t: 'Contratos y garantías', d: 'Redactamos el contrato, verificamos garantías y seguimos los vencimientos.' },
  { t: 'Un solo interlocutor', d: 'El inquilino nos escribe a nosotros por cualquier tema. Vos no tenés que atender llamados.' },
];
---
<Base
  title="Administración de alquileres en Salsipuedes y Sierras Chicas"
  description="Administramos tu alquiler en Salsipuedes, Río Ceballos y Unquillo: cobranza, servicios, aumentos por índice y liquidación mensual con comprobante. Más de 130 alquileres en administración."
  activo="administracion"
  jsonLd={breadcrumbJsonLd(migas)}
>
  <div class="contenedor" style="padding-block:28px 96px">
    <Migas items={migas} />
    <div class="prosa">
      <h1>Administración de alquileres en Salsipuedes y Sierras Chicas</h1>
      <p>Si tenés una propiedad alquilada en las sierras y no querés ocuparte del día a día, nos encargamos de todo. Hoy administramos más de 130 alquileres en la zona.</p>
    </div>
    <div class="grilla" style="margin-top:36px">
      {servicios.map((s) => (
        <div class="guia-card">
          <h2 style="font-weight:600;font-size:20px">{s.t}</h2>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
    <div class="banda-wa" style="margin-top:48px">
      <div style="flex:1 1 320px">
        <h2 style="font-weight:700;font-size:28px">¿Querés que administremos tu propiedad?</h2>
        <p style="margin-top:10px;color:#C9C6C1">Contanos dónde está y cómo está hoy (alquilada o vacía) y te explicamos cómo trabajamos.</p>
      </div>
      <a class="btn btn--wa" href={waLink('Hola! Quiero consultar por la administración de mi alquiler.')} rel="noopener"><Icono nombre="wa" />Consultar por WhatsApp</a>
    </div>
  </div>
</Base>
