---
interface Props { nombre: 'wa' | 'buscar' | 'menu' | 'cerrar' | 'flecha'; tam?: number }
const { nombre, tam = 18 } = Astro.props;
---
<svg width={tam} height={tam} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'wa' && <path d="M3 21l1.7-5A8.5 8.5 0 1 1 8 19.3L3 21z" />}
  {nombre === 'buscar' && <><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></>}
  {nombre === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
